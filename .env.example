# Copy to .env and fill in. Nothing loads this automatically -- source it:
#
#     set -a; source .env; set +a
#
# Terraform does NOT read this file. Its inputs live in
# infra/prod/terraform.tfvars, and all nine have defaults, so `terraform
# apply` works with none of them set. The only thing Terraform needs from the
# environment is AWS credentials, which it picks up from ~/.aws the same way
# the CLI does -- so if `aws sts get-caller-identity` works, Terraform works.


# ---------------------------------------------------------------- AWS --------
# Read by the aws CLI, and therefore by terraform and push-to-ecr.sh.
# Leave AWS_PROFILE blank to use the default profile.
AWS_PROFILE=
AWS_REGION=

# push-to-ecr.sh only. Blank is fine -- it falls back to
# `aws sts get-caller-identity`, which costs one API call.
AWS_ACCOUNT_ID=


# ------------------------------------------------------- local dev only ------
# Both have working defaults in code; set them only to override.

# model/inference_cont.py. mps on Apple Silicon, cuda in the container.
DEVICE=

# backend/server.py. Point this at an SSM port-forward to drive the real GPU
# from your laptop:
#   aws ssm start-session --target i-xxxx \
#     --document-name AWS-StartPortForwardingSession \
#     --parameters '{"portNumber":["8080"],"localPortNumber":["8080"]}'
MODEL_URL=


# The frontend does not read this file. Next.js loads frontend/.env.local,
# and NEXT_PUBLIC_API_URL is set in Vercel's dashboard for deployments.
