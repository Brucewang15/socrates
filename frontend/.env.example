# Copy to .env.local for local dev. Next.js loads .env.local automatically --
# no dotenv package, no import.
#
# NEXT_PUBLIC_* is inlined into the client bundle at BUILD time, not read from
# the environment at runtime. Changing it means a rebuild, on Vercel as much as
# in Docker.
#
# On Vercel this is set per-environment in Project Settings -> Environment
# Variables, not from this file. Production wants the backend's https:// URL --
# a page served over https cannot call http://, the browser blocks it outright.
NEXT_PUBLIC_API_URL=http://localhost:8000
