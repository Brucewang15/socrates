# python
.venv/
__pycache__/
*.py[cod]
.pytest_cache/
.ruff_cache/
.mypy_cache/

# secrets
.env
# next reads these automatically; .env.example is the committed template
.env*.local

# model weights -- never commit these
*.safetensors
*.bin
*.gguf
*.pt
weights/

# build artifacts (day 4 CUDA kernels)
build/
*.so
*.o


# node
node_modules/
.next/
next-env.d.ts


# macos
.DS_Store

# terraform
**/.terraform/*
*.tfstate
*.tfstate.*
*.tfplan
crash.log
crash.*.log
# real values, often account ids and CIDRs -- the .example is the template
*.tfvars
*.tfvars.json
!*.tfvars.example
override.tf
override.tf.json
*_override.tf
*_override.tf.json
.terraformrc
terraform.rc
# .terraform.lock.hcl is deliberately NOT ignored: commit it so provider
# versions are identical on every machine
