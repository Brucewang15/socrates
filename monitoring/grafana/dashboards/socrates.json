{
  "uid": "socrates",
  "title": "Socrates inference",
  "tags": [
    "llm"
  ],
  "timezone": "browser",
  "schemaVersion": 39,
  "version": 1,
  "refresh": "10s",
  "time": {
    "from": "now-30m",
    "to": "now"
  },
  "panels": [
    {
      "id": 1,
      "type": "timeseries",
      "title": "Queue depth vs capacity",
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 12,
        "h": 7
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "expr": "socrates_queue_depth",
          "legendFormat": "waiting",
          "refId": "A"
        },
        {
          "expr": "socrates_active_rows",
          "legendFormat": "generating",
          "refId": "B"
        },
        {
          "expr": "socrates_max_batch",
          "legendFormat": "capacity",
          "refId": "C"
        }
      ],
      "fieldConfig": {
        "defaults": {},
        "overrides": []
      },
      "description": "The autoscaling signal. GPU utilisation is near 100% during decode regardless of load, so it cannot tell you this."
    },
    {
      "id": 2,
      "type": "timeseries",
      "title": "Batch occupancy",
      "gridPos": {
        "x": 12,
        "y": 0,
        "w": 12,
        "h": 7
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "expr": "socrates_active_rows / socrates_max_batch",
          "legendFormat": "occupancy",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit"
        },
        "overrides": []
      },
      "description": "Rows generating over MAX_BATCH. The gap is capacity paid for and not used."
    },
    {
      "id": 3,
      "type": "timeseries",
      "title": "TTFT",
      "gridPos": {
        "x": 0,
        "y": 7,
        "w": 8,
        "h": 7
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "expr": "histogram_quantile(0.50, sum by (le) (rate(socrates_ttft_seconds_bucket[5m])))",
          "legendFormat": "p50",
          "refId": "A"
        },
        {
          "expr": "histogram_quantile(0.95, sum by (le) (rate(socrates_ttft_seconds_bucket[5m])))",
          "legendFormat": "p95",
          "refId": "B"
        },
        {
          "expr": "histogram_quantile(0.99, sum by (le) (rate(socrates_ttft_seconds_bucket[5m])))",
          "legendFormat": "p99",
          "refId": "C"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s"
        },
        "overrides": []
      },
      "description": "Queue wait plus prefill. The p50/p99 gap is queueing."
    },
    {
      "id": 4,
      "type": "timeseries",
      "title": "ITL",
      "gridPos": {
        "x": 8,
        "y": 7,
        "w": 8,
        "h": 7
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "expr": "histogram_quantile(0.50, sum by (le) (rate(socrates_itl_seconds_bucket[5m])))",
          "legendFormat": "p50",
          "refId": "A"
        },
        {
          "expr": "histogram_quantile(0.95, sum by (le) (rate(socrates_itl_seconds_bucket[5m])))",
          "legendFormat": "p95",
          "refId": "B"
        },
        {
          "expr": "histogram_quantile(0.99, sum by (le) (rate(socrates_itl_seconds_bucket[5m])))",
          "legendFormat": "p99",
          "refId": "C"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s"
        },
        "overrides": []
      },
      "description": "Seconds per generated token. Rises with batch size and context length."
    },
    {
      "id": 5,
      "type": "timeseries",
      "title": "TTFT split",
      "gridPos": {
        "x": 16,
        "y": 7,
        "w": 8,
        "h": 7
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "expr": "histogram_quantile(0.95, sum by (le) (rate(socrates_queue_seconds_bucket[5m])))",
          "legendFormat": "queue p95",
          "refId": "A"
        },
        {
          "expr": "histogram_quantile(0.95, sum by (le) (rate(socrates_prefill_seconds_bucket[5m])))",
          "legendFormat": "prefill p95",
          "refId": "B"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s"
        },
        "overrides": []
      },
      "description": "Queue wait is the scheduler's; prefill is the model's."
    },
    {
      "id": 6,
      "type": "timeseries",
      "title": "Throughput",
      "gridPos": {
        "x": 0,
        "y": 14,
        "w": 12,
        "h": 7
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "expr": "rate(socrates_output_tokens_total[1m])",
          "legendFormat": "generated",
          "refId": "A"
        },
        {
          "expr": "rate(socrates_prompt_tokens_total[1m])",
          "legendFormat": "prefilled",
          "refId": "B"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "none"
        },
        "overrides": []
      },
      "description": "Tokens/sec. A rate, so percentiles do not apply."
    },
    {
      "id": 7,
      "type": "timeseries",
      "title": "Request rate by outcome",
      "gridPos": {
        "x": 12,
        "y": 14,
        "w": 12,
        "h": 7
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "expr": "sum by (outcome) (rate(socrates_requests_total[1m]))",
          "legendFormat": "{{outcome}}",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "reqps"
        },
        "overrides": []
      },
      "description": "429 queue_full, 413 too_long and 504 timeout fail for different reasons."
    },
    {
      "id": 8,
      "type": "timeseries",
      "title": "GPU utilisation & memory",
      "gridPos": {
        "x": 0,
        "y": 21,
        "w": 12,
        "h": 7
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "expr": "DCGM_FI_DEV_GPU_UTIL",
          "legendFormat": "SM util %",
          "refId": "A"
        },
        {
          "expr": "DCGM_FI_DEV_FB_USED / (DCGM_FI_DEV_FB_USED + DCGM_FI_DEV_FB_FREE) * 100",
          "legendFormat": "VRAM %",
          "refId": "B"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percent"
        },
        "overrides": []
      },
      "description": "SM util saturates during decode; treat VRAM and the bandwidth panel as the real signals."
    },
    {
      "id": 9,
      "type": "timeseries",
      "title": "GPU memory bandwidth & temp",
      "gridPos": {
        "x": 12,
        "y": 21,
        "w": 12,
        "h": 7
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "expr": "DCGM_FI_PROF_DRAM_ACTIVE * 100",
          "legendFormat": "DRAM active %",
          "refId": "A"
        },
        {
          "expr": "DCGM_FI_DEV_GPU_TEMP",
          "legendFormat": "temp C",
          "refId": "B"
        }
      ],
      "fieldConfig": {
        "defaults": {},
        "overrides": []
      },
      "description": "DRAM active is the hardware's own view of memory bandwidth utilisation -- the ceiling decode is pressed against."
    }
  ]
}
